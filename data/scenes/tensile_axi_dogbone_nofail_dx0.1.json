# ==============================================================================
# Axisymmetric round-bar dogbone in tension, strength only (no damage card), dx0 = 0.1 mm
# ==============================================================================
# tensile_axi_dogbone.json with its Johnson-Cook fracture card removed: the same bar
# (Ø10 mm heads, Ø6 mm gauge, 20.36 mm fillet radius), the same stainless_steel strength,
# grips, ramp and stabilisers.  It is the deck family of the resolution study of claim (c)
# in PUBLICATION_PLAN_hourglass.md, which compares the continuum answer and must not be
# confounded with the fracture model's own convergence; the card acts only after the peak
# and leaves every pre-peak number unchanged.  The five levels, tensile_axi_dogbone_nofail
# (0.2) and _dx0.4 / _dx0.1 / _dx0.05 / _dx0.025, differ only in particleRadius and the
# block's axis offset start[1] = particleRadius.
# Read with tools/dogbone_convergence.py; tools/dogbone_static_fe.py gives the static
# elastic stiffness of the same model (399.9 kN/mm) to read K against.  At the deck's
# CFL 0.3 the sub-stepped hourglass damper adds +3 to +5% to K; K for comparison is taken
# at CFL 0.0375 (reports/axi_dogbone_convergence_2026-09-29.md).
# Unit system: mm, GPa, ms (density in kg/mm^3, velocity in mm/ms = m/s).
# ==============================================================================
{
  "Domain": {
    "particleRadius": 0.05,      # dx0 = 0.1 mm
    "supportRadiusFactor": 6.0,     # h = 3 dx0, fixed across the resolution study
    "axisymmetric": true,           # (x, r) half-plane revolved about the x axis
    "boundary": "open"
  },
  "Time": {
    "CFL": 0.3,
    "duration": 0.5,                # grips have moved 5.83 mm each by then (ramp below)
    "maxSteps": 400000,
    "stepsPerRenderUpdate": 50
  },
  "Solver": {
    "type": "hypoElastic",
    "viscosity": 0.02,
    "allowNegativePressure": true,
    "dampingCoefficient": 0.0,
    "kernelCorrection": false
  },
  "Materials": [
    {
      "name": "specimen",
      "library": "stainless_steel"    # JC strength A 0.31, B 1.0 GPa, n 0.65, C 0.02; no damage
    }
  ],
  "Load": {
    "gravitation": [0.0, 0.0, 0.0],
    "rampTime": 0.9                 # smoothstep ramp of the grip displacement, then hold
  },
  "Diffusion": {
    "delta": 0.1
  },
  "Shifting": {
    "enabled": true,
    "mode": "colle",
    "maMode": "fixed",
    "maFixed": 0.05,
    "R": 0.2,
    "n": 4,
    "maxShift": 0.05,
    "aleMomentum": true,
    "aleHistory": true              # also carries omega and D with a shifted particle
  },
  "Hourglass": {
    "alpha": 4.0,
    "superTimeStepping": {
      "mode": "subcycle"
    }
  },
  "Output": {
    "netcdf": false,                # the study reads the constraints CSV; the fine levels would write GBs
    "constraints": true,
    "constraintsInterval": 1,       # every step, for a smooth force-displacement curve
    "txt": false,
    "ply": false,
    "obj": false,
    "frame": false,
    "interval": 20,
    "colorField": "epsPlastic",
    "cameraMode": "front"
  },
  "SolidBlocks": [
    {
      "objectId": 0,
      "start": [0, 0.05, 0.0],     # start[1] = particleRadius: innermost ring at r = dx0/2
      "end": [40.0, 40.0, 0.05],
      "translation": [-20, 0.0, 0.0], # centres the bar on x = 0
      "scale": [1, 1, 1],
      "velocity": [0.0, 0.0, 0.0],
      "density": 7.9e-06,
      "color": [200, 120, 60],
      "shape": {
        "type": "dogboneaxi",
        "tabWidth": 10.0,             # head diameter [mm]
        "tabHeight": 3.6,
        "gaugeWidth": 6,              # gauge diameter [mm]: A0 = 28.27 mm^2
        "radius": 20.36               # fillet radius [mm]
      },
      "material": "specimen"
    }
  ],
  "Constraints": [
    {
      "name": "left",                 # left head, pulled -10 mm over rampTime
      "region": [[-20, 0, -1.0], [-10, 20, 1.0]],
      "components": "xy",
      "displacement": [-10.0, 0.0, 0.0]
    },
    {
      "name": "right",                # right head, pulled +10 mm over rampTime
      "region": [[10.0, 0.0, -1.0], [20, 20.0, 1.0]],
      "components": "xy",
      "displacement": [10.0, 0.0, 0.0]
    }
  ]
}
