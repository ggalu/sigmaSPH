# ==============================================================================
# Chocron et al. (2019) aluminium sphere into 150 MPa concrete -- 3D quarter,
# dx0 = 1 mm, HJC concrete WITH the Grady-Kipp tension card, run for the fragments
# ==============================================================================
# Reference: Kim, Yoo, Jo & Kim (2025), Int. J. Fract. 249:52, section 3.2, after
#            Chocron et al. (2019).  HJC constants: Kim et al. Table 5 (Chen et al. 2023).
#
# Physical configuration:
#   - Impactor: aluminium sphere, diameter 25.4 mm (Kim et al. Table 2 aluminium,
#     Johnson-Cook on a Mie-Grueneisen EOS), 2,000 m/s along +x.
#   - Target: 150 MPa concrete plate, diameter 300 mm, thickness 24 mm, free (no support).
#   - Discretisation: Cartesian quarter model, mirror planes y = 0 and z = 0
#     (symmetryPlanes "yz"); dx0 = 1 mm (particle radius 0.5 mm), about 426k particles,
#     a quarter of Kim et al.'s 1.7 M at their own spacing.
#   - Unit system: mm, ms, GPa (density in kg/mm^3, velocity in mm/ms = m/s).
#
# Purpose: the long-time fragmentation of the plate (CODE_DESCRIPTION 6.11, "The
# Grady-Kipp tension card"; reports/hjc_tension_grady_kipp_2026-09-26.md).  It is the
# 1 mm twin of the 2 mm deck hvi_3d_quarter_al_concrete150_chocron_gk_dx2_mm_GPa_ms.json,
# retired on 2026-09-27 (in the history up to commit 1a58098), and differs from it only
# in what the spacing sets.  At 2 mm the plate broke into sectors; at 1 mm it stays one
# body (65.5% of the mass, 34.4% rubble), because the Weibull size effect makes each
# particle 8^(1/8) = 1.30 times stronger -- see section 8 of the report above.
#
# Cost: run once, 57 minutes and 7.8 GB of NetCDF (176 frames of 426k particles), total
# energy error +0.58%.  Evaluate with
#   python3 tools/fragment_distribution.py hvi_3d_quarter_al_concrete150_chocron_gk_mm_GPa_ms.nc \
#       --dx0 1 --quarter --times 0.1 0.3 0.6 1.1 --png fragments_dx1.png
# ==============================================================================

{
  "Domain": {
    "particleRadius": 0.5,            # dx0 = 1 mm, Kim et al.'s own spacing
    "supportRadiusFactor": 6.0,       # kernel support 3 dx0 = 3 mm
    "planeStrain": false,
    "symmetryPlanes": "yz",           # quarter model: mirror images across y = 0 and z = 0.
                                      # Every flaw is mirrored too, so a fragment meeting a
                                      # plane has its shape there forced; the fragment tool
                                      # flags those (--quarter).
    "boundary": "open"                # unbounded hashed neighbour search, no walls
  },

  "Time": {
    "CFL": 0.3,
    "duration": 1.103,                # contact at ~3 us (the sphere starts 2 h = 6 mm clear),
                                      # so this is 1.1 ms after impact.  The crater of the
                                      # 80 mm comparison is read at 0.1 ms; the fragment
                                      # pattern at 2 mm was fixed from 0.1 ms on.
    "maxSteps": 400000,               # ~2x the 2 mm deck's steps; a ceiling, not a target
    "stepsPerRenderUpdate": 20,
    "pairSoundSpeed": "off"           # acoustic dt from CFL h / c_p; the pair estimate reads
                                      # nonsense across the Al/concrete interface (6.9)
  },

  "Erosion": {
    "mode": "cap",                    # volume ratio clamped into [0.3, 5]: bounds the EOS of a
    "minVolumeRatio": 0.3,            # particle that runs away, without removing it
    "maxVolumeRatio": 5.0
  },

  "Solver": {
    "type": "hypoElastic",
    "viscosity": 0.0,                 # no Morris viscosity in a solid
    "allowNegativePressure": true,    # the EOS may go into tension; the damage decides what
                                      # tension is carried
    "dampingCoefficient": 0.0,
    "kernelCorrection": false,

    # von Neumann-Richtmyer bulk viscosity q = C_Q rho l^2 (div v)^2, compression only.
    "bulkViscosity": {
      "quadratic": 1.5,
      "lengthScale": "dx0"
    },

    # Monaghan pairwise viscosity, approaching pairs only, so it does not resist a crack
    # opening.  beta is the contact penalty at the 2 km/s interface.
    "artificialViscosity": {
      "alpha": 1.0,
      "beta": 2.0
    }
  },

  "Materials": [
    {
      "name": "projectile",
      "library": "aluminium_kim2025"  # Kim et al. Table 2: JC + Mie-Grueneisen, c0 5.3, s 1.5
    },
    {
      "name": "plate",
      "library": "concrete_hjc_150",  # HJC compaction EOS, strength and damage, Table 5
      "damage": {
        # The Grady-Kipp tension card (DAM003).  HJC keeps compression; tension goes to
        # Weibull flaws that each particle draws at the start and that grow at a finite
        # crack speed.  Merged onto the library HJC damage card (D1, D2, EFMIN).
        "tension": {
          "model": "gradyKipp",
          "m": 8.0,                   # Weibull modulus: the flaw-strength scatter, and with it
                                      # the size effect (V_ref/V)^(1/m).  An assumption from the
                                      # 5-12 range quoted for concrete, not a sourced value.
          "referenceVolume": 5.301e6, # mm^3, a 150 x 300 mm cylinder: the specimen on which the
                                      # eos tensileStrength T = 7.59 MPa is taken as the weakest-
                                      # flaw strength.  At 1 mm a particle is 1 mm^3, so its
                                      # weakest flaw is stronger than at 2 mm by 8^(1/8) = 1.30.
          "crackSpeedFactor": 0.4,    # c_g = 0.4 c_l = 1.59 km/s
          "seed": 1,                  # the flaw draw; another seed is another sample of the
                                      # same concrete
          "flawCap": false            # Benz-Asphaug's cap D_t <= n_act/n OFF: with it the crack
                                      # bands stay partially damaged and the 2 mm plate stayed
                                      # one connected body (80%); without it cracks separate
                                      # what lies on either side.  A deliberate departure.
        }
      }
    }
  ],

  "Load": {
    "gravitation": [0.0, 0.0, 0.0]
  },

  "Diffusion": {
    "delta": 0.1,                     # delta-SPH density diffusion; switched off across a
                                      # cracked bond (D_t >= 0.99) by the solver itself
    "pairs": "sameMaterial"
  },

  "Shifting": {
    "enabled": true,
    "aleEnergyConservative": true,    # global fix-up of the non-conservative ALE advection of
                                      # e_int (16.1); on for every Chocron deck
    "mode": "colle",
    "maMode": "fixed",
    "maFixed": 0.05,
    "R": 0.2,
    "n": 4,
    "maxShift": 0.005,
    "aleMomentum": true,
    "aleHistory": true                # D_c, mu_max and D_t move with a shifted particle; the
                                      # flaws do not (they belong to the material)
  },

  "Hourglass": {
    "alpha": 2.0,
    "superTimeStepping": {
      "mode": "subcycle"
    }
  },

  "Output": {
    "netcdf": true,                   # damage_t (tensile damage) and flaw_eps_min (each
                                      # particle's weakest-flaw strain) are written with the
                                      # usual fields
    "txt": false,
    "ply": false,
    "obj": false,
    "frame": false,
    "interval": 5,
    "colorField": "damageTension",    # the GUI shows D_t: the cracks
    "cameraMode": "front"
  },

  "SolidBlocks": [
    {
      "objectId": 0,
      "material": "projectile",
      "start": [-31.41, 0.5, 0.5],    # lattice box around the quarter sphere, half a spacing
      "end": [-5.999, 12.701, 12.701],# off the mirror planes
      "translation": [0.0, 0.0, 0.0],
      "scale": [1.0, 1.0, 1.0],
      "velocity": [2000.0, 0.0, 0.0], # 2 km/s along +x
      "density": 2.71e-06,
      "color": [210, 120, 60],
      "shape": {
        "type": "sphere",
        "radius": 12.7,
        "center": [-18.7, 0.0, 0.0]   # surface 6 mm = 2 h in front of the plate
      }
    },
    {
      "objectId": 1,
      "material": "plate",
      "start": [0.5, 0.5, 0.5],
      "end": [24.001, 150.001, 150.001],
      "translation": [0.0, 0.0, 0.0],
      "scale": [1.0, 1.0, 1.0],
      "velocity": [0.0, 0.0, 0.0],
      "density": 2.7e-06,
      "color": [160, 160, 175],
      "shape": {
        "type": "cylinder",           # the Ø300 mm plate, 24 mm thick, face at x = 0
        "radius": 150.0,
        "axis": "x",
        "center": [12.0, 0.0, 0.0]
      }
    }
  ]
}
